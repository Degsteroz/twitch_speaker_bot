# Local development. Copy to `.env` (git-ignored) and fill in:  cp .env.example .env
# Production uses deploy/.env instead — see deploy/.env.example.
# The api, worker, twitch and db scripts load this file via `--env-file=../../.env`.

# PostgreSQL 16 running locally.
DATABASE_URL=postgres://roast:roast@localhost:5432/roast

# Dashboard on Vite (5173) talks to the API on 3000.
PUBLIC_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:5173

# Twitch application (https://dev.twitch.tv/console/apps). Register exactly this callback.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:3000/auth/twitch/callback
# YOUR numeric Twitch user ID as the service owner (not a streamer's), comma-separated if several.
# Owners get /admin (with mandatory 2FA) and approve streamers there; streamers never go here.
TWITCH_OWNER_IDS=
# Optional: point EventSub at the Twitch CLI mock instead of Twitch
# (`twitch event websocket start-server`, then `twitch event trigger channel.raid --transport=websocket`).
# TWITCH_EVENTSUB_WS_URL=ws://127.0.0.1:8080/ws
# TWITCH_EVENTSUB_SUBSCRIPTIONS_URL=http://127.0.0.1:8080/eventsub/subscriptions

# Generate:  openssl rand -base64 48   (each one separately)
SESSION_SECRET=
AUDIO_SIGNING_SECRET=
# Exactly 64 hex characters:  openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
CLASSIFIER_MODEL=claude-sonnet-5-5

# DonationAlerts app (donationalerts.com/application/clients). Optional: without it the panel
# hides the integration. Redirect URL to register: PUBLIC_URL + /integrations/donationalerts/callback
DONATIONALERTS_CLIENT_ID=
DONATIONALERTS_CLIENT_SECRET=

# Yandex SpeechKit character voices (optional; after the good voices, and after the plan's good
# roasts; the local Piper speaks only when every cloud voice failed).
YANDEX_TTS_API_KEY=

# ElevenLabs (optional, tried first while its plan lasts). Voice IDs come from the ElevenLabs
# voice library; a character without a voice ID goes on to Inworld/Yandex. Monthly cap: /admin.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_v4
ELEVENLABS_VOICE_TSUNDERE=
ELEVENLABS_VOICE_YANDERE=

# Inworld (optional, tried after ElevenLabs: the main voice once ElevenLabs runs out). The key from
# platform.inworld.ai is already Base64: paste it as is. Voice IDs for Mitsuki and Ai; voices for
# own characters are added in /admin/characters. Monthly character cap: /admin.
INWORLD_API_KEY=
INWORLD_MODEL=inworld-tts-2-flash
INWORLD_VOICE_TSUNDERE=
INWORLD_VOICE_YANDERE=

# Local TTS container (services/tts). Absolute path: api and worker must share it.
TTS_URL=http://localhost:8000
AUDIO_DIR=/tmp/roastbot-audio
# Roasts the worker writes at once.
WORKER_CONCURRENCY=4

# Optional daily report.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Streamer bot (same token): notifications, the summary after a stream and Telegram Stars plans.
# Needs all three; the API registers the webhook PUBLIC_URL/telegram/webhook at start.
# TELEGRAM_BOT_USERNAME without @; TELEGRAM_WEBHOOK_SECRET:  openssl rand -hex 24
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
