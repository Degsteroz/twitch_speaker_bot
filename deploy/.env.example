# Edge mode (deploy/edge-deploy.sh, behind another project's Caddy) uses one domain:
#   APP_DOMAIN=roast.recursia.online
#   PUBLIC_URL=https://roast.recursia.online/api
#   DASHBOARD_URL=https://roast.recursia.online
#   TWITCH_REDIRECT_URI=https://roast.recursia.online/api/auth/twitch/callback
# API_DOMAIN, ACME_EMAIL, GHCR_OWNER, IMAGE_TAG and the *_BIND / *_HOST_PORT values are unused
# there; leave the placeholders. Everything below the Postgres line applies to both modes.

# Domains must resolve to this server. Do not include scheme or path.
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
ACME_EMAIL=admin@example.com

# GHCR namespace and immutable release tag (for example a commit SHA).
GHCR_OWNER=your-github-user-or-org
IMAGE_TAG=latest

# Set both to 127.0.0.1 when an existing host reverse proxy terminates TLS.
HTTP_BIND=0.0.0.0
HTTPS_BIND=0.0.0.0
# Loopback ports used only with docker-compose.existing-proxy.yml.
API_HOST_PORT=3000
WEB_HOST_PORT=8080
OVERLAY_HOST_PORT=8081

POSTGRES_DB=roastbot
POSTGRES_USER=roastbot
# Generate with: openssl rand -base64 36
# URL-encode reserved characters in DATABASE_URL (for example / becomes %2F).
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://roastbot:replace-with-url-encoded-password@postgres:5432/roastbot

# Same-origin API base; no trailing slash. This keeps OAuth cookies on APP_DOMAIN.
PUBLIC_URL=https://app.example.com/api
DASHBOARD_URL=https://app.example.com
TWITCH_REDIRECT_URI=https://app.example.com/api/auth/twitch/callback

TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Numeric Twitch user ID of the service owner (you), not of streamers; comma-separated.
# Owners receive /admin with mandatory 2FA; streamers are approved or invited in /admin.
TWITCH_OWNER_IDS=

# Generate each independently with: openssl rand -base64 48
SESSION_SECRET=
AUDIO_SIGNING_SECRET=
# Master key for Twitch token encryption: exactly 32 random bytes encoded as
# 64 hexadecimal characters. Generate with: openssl rand -hex 32
# Keep this stable; changing it makes stored Twitch tokens unreadable.
TOKEN_ENCRYPTION_KEY=

ANTHROPIC_API_KEY=
# Used only while idempotently seeding the initial model setting.
ANTHROPIC_MODEL=claude-opus-5-5
CLASSIFIER_MODEL=claude-sonnet-5-5

# DonationAlerts app (donationalerts.com/application/clients). Optional: without it the panel
# hides the integration. Redirect URL to register: PUBLIC_URL + /integrations/donationalerts/callback
DONATIONALERTS_CLIENT_ID=
DONATIONALERTS_CLIENT_SECRET=

# Yandex SpeechKit voices for the characters (service account with role ai.speechkit-tts.user,
# API key). Optional: when empty, or when Yandex fails or is slow, the local Piper voice is used.
YANDEX_TTS_API_KEY=

# ElevenLabs (optional, tried before Yandex). Voice IDs come from the ElevenLabs voice library;
# a character without a voice ID is voiced by Yandex/Piper. Monthly character cap: /admin.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_v4
ELEVENLABS_VOICE_TSUNDERE=
ELEVENLABS_VOICE_YANDERE=

# Optional Telegram daily report (09:00 in the worker container's timezone).
# Set both or leave both empty.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Streamer bot (same token): notifications, the summary after a stream and Telegram Stars plans.
# Needs all three; the API registers the webhook PUBLIC_URL/telegram/webhook at start.
# TELEGRAM_BOT_USERNAME without @; TELEGRAM_WEBHOOK_SECRET:  openssl rand -hex 24
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Piper fallback voice (the characters speak through Yandex SpeechKit). The .onnx and matching
# .onnx.json must be in the Docker volume roastbot_models; edge-deploy.sh downloads them.
# Cached WAVs older than TTS_CACHE_MAX_AGE_SECONDS are pruned.
FEMALE_MODEL=ru_RU-irina-medium.onnx
TTS_CACHE_MAX_AGE_SECONDS=86400

# Used by services/tts/download_models.py. Pinned to rhasspy/piper-voices v1.0.0
# on Hugging Face; the SHA-256 values were taken from that tag on 2026-10-23.
# Re-verify before production and check each voice's license (plan §13).
IRINA_URL=https://huggingface.co/rhasspy/piper-voices/resolve/v1.0.0/ru/ru_RU/irina/medium/ru_RU-irina-medium.onnx
IRINA_SHA256=8ff38212d23da300bbe3705c645e6e5b9475f0bfde01558eb17813e22acaaaaa
IRINA_CONFIG_URL=https://huggingface.co/rhasspy/piper-voices/resolve/v1.0.0/ru/ru_RU/irina/medium/ru_RU-irina-medium.onnx.json
IRINA_CONFIG_SHA256=c2ec28bb38e2b59e93b959b3e40348c1afebbd272f30fed5d41205d08e98a9d7

# Backup scripts. BACKUP_EXTERNAL_HOOK is an executable receiving the completed
# archive path as argument 1 (for example an rclone wrapper).
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=7
BACKUP_EXTERNAL_HOOK=
