# Domains must resolve to this server. Do not include scheme or path.
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
ACME_EMAIL=admin@example.com

# GHCR namespace and immutable release tag (for example a commit SHA).
GHCR_OWNER=your-github-user-or-org
IMAGE_TAG=latest

# Set both to 127.0.0.1 when an existing host reverse proxy terminates TLS.
HTTP_BIND=0.0.0.0
HTTPS_BIND=0.0.0.0
# Loopback ports used only with docker-compose.existing-proxy.yml.
API_HOST_PORT=3000
WEB_HOST_PORT=8080
OVERLAY_HOST_PORT=8081

POSTGRES_DB=roastbot
POSTGRES_USER=roastbot
# Generate with: openssl rand -base64 36
# URL-encode reserved characters in DATABASE_URL (for example / becomes %2F).
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://roastbot:replace-with-url-encoded-password@postgres:5432/roastbot

# Same-origin API base; no trailing slash. This keeps OAuth cookies on APP_DOMAIN.
PUBLIC_URL=https://app.example.com/api
DASHBOARD_URL=https://app.example.com
TWITCH_REDIRECT_URI=https://app.example.com/api/auth/twitch/callback

TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Numeric Twitch user IDs, comma-separated. These users receive owner/admin role.
TWITCH_OWNER_IDS=

# Generate each independently with: openssl rand -base64 48
SESSION_SECRET=
AUDIO_SIGNING_SECRET=
# Master key for Twitch token encryption: exactly 32 random bytes encoded as
# 64 hexadecimal characters. Generate with: openssl rand -hex 32
# Keep this stable; changing it makes stored Twitch tokens unreadable.
TOKEN_ENCRYPTION_KEY=

ANTHROPIC_API_KEY=
# Used only while idempotently seeding the initial model setting.
ANTHROPIC_MODEL=claude-haiku-5-5

# Optional Telegram daily report (09:00 in the worker container's timezone).
# Set both or leave both empty.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Piper voices. Both .onnx and matching .onnx.json files must already exist in
# the named Docker volume roastbot_models. Cached WAVs older than this are pruned.
MALE_MODEL=ru_RU-denis-medium.onnx
FEMALE_MODEL=ru_RU-irina-medium.onnx
TTS_CACHE_MAX_AGE_SECONDS=86400

# Used by services/tts/download_models.py. Pinned to rhasspy/piper-voices v1.0.0
# on Hugging Face; the SHA-256 values were taken from that tag on 2026-10-23.
# Re-verify before production and check each voice's license (plan §13).
DENIS_URL=https://huggingface.co/rhasspy/piper-voices/resolve/v1.0.0/ru/ru_RU/denis/medium/ru_RU-denis-medium.onnx
DENIS_SHA256=15fab56e11a097858ee115545d0f697fc2a316c41a291a5362349fb870411b0a
DENIS_CONFIG_URL=https://huggingface.co/rhasspy/piper-voices/resolve/v1.0.0/ru/ru_RU/denis/medium/ru_RU-denis-medium.onnx.json
DENIS_CONFIG_SHA256=831c860dac0b5073eaa81610a0a638ec23d90a6cf8e5f871b4485c2cec3767c8
IRINA_URL=https://huggingface.co/rhasspy/piper-voices/resolve/v1.0.0/ru/ru_RU/irina/medium/ru_RU-irina-medium.onnx
IRINA_SHA256=8ff38212d23da300bbe3705c645e6e5b9475f0bfde01558eb17813e22acaaaaa
IRINA_CONFIG_URL=https://huggingface.co/rhasspy/piper-voices/resolve/v1.0.0/ru/ru_RU/irina/medium/ru_RU-irina-medium.onnx.json
IRINA_CONFIG_SHA256=c2ec28bb38e2b59e93b959b3e40348c1afebbd272f30fed5d41205d08e98a9d7

# Backup scripts. BACKUP_EXTERNAL_HOOK is an executable receiving the completed
# archive path as argument 1 (for example an rclone wrapper).
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=7
BACKUP_EXTERNAL_HOOK=
